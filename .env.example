# --- Deployment (docker-compose.yml reads these directly; for a local,
#     non-Docker dev setup you can leave ENVIRONMENT at its "development"
#     default and skip the rest of this section) ---
# ENVIRONMENT=production
# POSTGRES_PASSWORD=              # required by docker-compose.yml — pick a real password
# JWT_SECRET=                     # required in production — generate with: openssl rand -hex 32
# JWT_EXPIRE_MINUTES=1440
# DOMAIN=quantsphere.example.com  # only needed if you're using the optional Caddy reverse proxy

# --- Database ---
# When running via docker-compose.yml this is overridden to point at the
# `db` service automatically — only used as-is for local, non-Docker dev.
DATABASE_URL=postgresql+asyncpg://quantsphere:quantsphere@localhost:5432/quantsphere

# --- Local Ollama (Hybrid XAI Phase B) ---
# When running via docker-compose.yml this is overridden to the `ollama`
# service automatically — only used as-is for local, non-Docker dev. After
# `docker compose up`, pull the models once with:
#   docker compose exec ollama ollama pull llama3
#   docker compose exec ollama ollama pull llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3
OLLAMA_VISION_MODEL=llama3.2-vision

# --- MetaTrader 5 direct-connect (single local terminal only — see
#     bridge/README.md for the multi-user-compatible alternative) ---
# Off by default (and forced off by docker-compose.yml regardless of this
# value) since it can't serve multiple hosted users from one server process.
# Only meaningful for a single-user, non-Docker local install.
MT5_ENABLED=false
# Link an account from the dashboard's "Connect MT5 Account" UI instead of
# here — credentials are encrypted at rest. MT5_ENCRYPTION_KEY is
# auto-generated and appended to .env the first time an account is linked.
MT5_POLL_INTERVAL_SECONDS=15
# Optional: only needed if mt5.initialize() can't auto-detect an installed terminal.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Screenshot storage ---
MEDIA_ROOT=./media
MAX_UPLOAD_MB=8

# --- Account emails (welcome on signup, "forgot password" reset link) ---
# Optional — leave SMTP_HOST blank and the app just skips sending (logs it
# instead) rather than failing signup/login. Works with any SMTP provider:
# a Gmail account + App Password (myaccount.google.com/apppasswords) is the
# easiest way to get started, but Outlook/Office365 or any transactional
# SMTP relay (SES, Mailgun, Resend, etc.) works the same way.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=                    # an App Password, not your normal login password
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=                  # defaults to SMTP_USERNAME if left blank
# SMTP_FROM_NAME=QuantSphere
